{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "/server.js",
      "/package.json",
      "/package-lock.json",
      "/railway.json",
      "/lib/**",
      "/public/**",
      "/Dockerfile"
    ],
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1,
    "drainingSeconds": 30
  }
}
